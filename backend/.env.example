# --- Database ----------------------------------------------------------
# Zero-setup local default:
DATABASE_URL=sqlite+aiosqlite:///./leadguard.db
# PostgreSQL (used by docker compose):
# DATABASE_URL=postgresql+asyncpg://leadguard:leadguard@db:5432/leadguard

# --- AI provider -------------------------------------------------------
# "mock" needs no API key and keeps the demo fully reproducible.
AI_PROVIDER=mock
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# --- Decision thresholds ----------------------------------------------
QUALIFIED_THRESHOLD=80
REVIEW_THRESHOLD=50

# --- Duplicate handling -----------------------------------------------
DUPLICATE_PENALTY=40
DUPLICATE_BLOCKS_QUALIFICATION=true
DUPLICATE_SIMILARITY_THRESHOLD=80

# --- Fake CRM ----------------------------------------------------------
# Leave empty to loop back into this app's own /api/fake-crm endpoint.
CRM_BASE_URL=
CRM_TIMEOUT_SECONDS=5
CRM_MAX_ATTEMPTS=3
# Set to 1 to simulate a CRM outage and demo the retry / failure path.
CRM_FAIL_RATE=0

# --- Demo --------------------------------------------------------------
SEED_ON_STARTUP=false
